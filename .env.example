# Generated with `pnpm run init` or edited manually.
# Comma separated list of paths to music libraries
MUSIC_LIBRARY_PATH=""
# Directory where the sqlite db file should live. Megawave creates megawave.db inside it.
DATABASE_PATH="./db"

# Optional authentication. When MEGAWAVE_AUTH=true, MEGAWAVE_SECRET must be at least 32 characters.
MEGAWAVE_AUTH=false
MEGAWAVE_SECRET=""

# Optional initial admin account seed. Used only when auth is enabled and the email does not exist yet.
MEGAWAVE_AUTH_SEED_EMAIL=""
MEGAWAVE_AUTH_SEED_PASSWORD=""
MEGAWAVE_AUTH_SEED_NAME="Megawave Admin"
MEGAWAVE_AUTH_ADMIN_EMAILS=""

# Public account creation controls. Whitelist entries are managed from the Megawave admin page.
MEGAWAVE_AUTH_SIGNUP=true
MEGAWAVE_AUTH_SIGNUP_WHITELIST=false
